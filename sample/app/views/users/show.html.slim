- provide(:title, @user.name)
.row
    aside.col-md-4
        section.user_info
            = link_to image_tag("ume.jpeg", class: "ume", alt: "ume"), "https://www.daigothebeast.com/"
            h1
                = @user.name
            .score
                p レベル: 1
                p 攻撃力: 1
                p 防御力: 1
    .col-md-8
        h3 Microposts
        - if @user.microposts.any?
            h3 Microposts
            = @user.microposts.count
            ol.microposts
                = render @microposts
